{
  "name": "phenix-null-eden",
  "productName": "PHENIX NULL EDEN",
  "version": "1.0.0",
  "description": "A cyber-survival roguelite by InkSpireM Visuals",
  "main": "main.js",
  "author": "InkSpireM Visuals",
  "scripts": {
    "prepare-game": "node prepare-game.js",
    "start": "electron .",
    "selftest": "electron . --phenix-selftest",
    "dist": "node prepare-game.js && electron-builder --win"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.inkspirem.phenixnulleden",
    "productName": "PHENIX NULL EDEN",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "game/**/*",
      "node_modules/**/*",
      "!node_modules/steamworks.js/dist/linux64/**",
      "!node_modules/steamworks.js/dist/osx/**",
      "!node_modules/**/{README,readme,CHANGELOG,LICENSE}*",
      "!node_modules/**/*.{md,ts,map}"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/steamworks.js/**"
    ],
    "extraFiles": [
      {
        "from": "node_modules/steamworks.js/dist/win64/steam_api64.dll",
        "to": "steam_api64.dll"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "game/assets/pwa/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
